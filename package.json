{
  "name": "@adobe/progen-audit-dashboard",
  "private": true,
  "version": "1.1.0",
  "description": "Starter project for Adobe Helix",
  "scripts": {
    "build": "npm run tw:build",
    "hooks:install": "git config core.hooksPath .githooks",
    "lint:js": "npx eslint .",
    "lint:css": "npx stylelint \"blocks/**/*.tw.css\" \"styles/*.tw.css\" \"styles/styles.css\"",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix",
    "dev": "aem up & npm run tw:watch",
    "tw:build": "node tailwind-build.js",
    "tw:watch": "node tailwind-watch.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ACS-UI/progen-audit-dashboard.git"
  },
  "author": "Adobe",
  "license": "Apache License 2.0",
  "bugs": {
    "url": "https://github.com/ACS-UI/progen-audit-dashboard/issues"
  },
  "homepage": "https://github.com/ACS-UI/progen-audit-dashboard#readme",
  "devDependencies": {
    "@babel/eslint-parser": "7.28.6",
    "@tailwindcss/cli": "^4.2.2",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.32.0",
    "stylelint": "17.1.1",
    "stylelint-config-standard": "40.0.0",
    "tailwindcss": "^4.2.2"
  },
  "dependencies": {
    "fast-glob": "^3.3.3"
  }
}
